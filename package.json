{
  "name": "commit-discipline-mcp",
  "version": "0.1.0",
  "description": "Plan and enforce small, test-gated Git commits through MCP or a CLI.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "git",
    "commit",
    "cli",
    "developer-tools",
    "ai-agents",
    "coding-agents",
    "commit-workflow",
    "codex",
    "claude-code",
    "cursor"
  ],
  "author": "Ayush Singh",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayush-singh-0601/commit-discipline-mcp.git"
  },
  "homepage": "https://github.com/ayush-singh-0601/commit-discipline-mcp#readme",
  "bugs": {
    "url": "https://github.com/ayush-singh-0601/commit-discipline-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "commit-discipline": "bin/commit-discipline.js",
    "commit-discipline-mcp": "bin/commit-discipline.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "benchmark:git": "npm run build && node scripts/benchmark-git.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/jest": "30.0.0",
    "expect": "29.7.0",
    "typescript": "5.9.3"
  }
}
