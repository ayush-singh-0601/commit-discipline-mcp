{
  "name": "commit-discipline-mcp",
  "version": "0.1.0",
  "description": "Plan and enforce small, test-gated Git commits through MCP or a CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "commit-discipline": "bin/commit-discipline.js",
    "commit-discipline-mcp": "bin/commit-discipline.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/jest": "29.5.14",
    "expect": "29.7.0",
    "typescript": "5.9.3"
  }
}
